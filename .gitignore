# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.swc
/out/

# production
/build

# packages: the kit's build output (rebuilt by prepublishOnly, shipped in the npm tarball via
# its package.json "files", never committed as source).
packages/*/dist
packages/*/node_modules
packages/*/*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (local secrets stay out; the committed example is the contract)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state: worktrees carry their own node_modules and .next,
# so an unguarded `git add -A` would stage ~800MB. Narrow on purpose, so real
# project config (.claude/settings.json, .claude/skills/) stays trackable.
/.claude/worktrees/
/.claude/auto-worktree

# hero generation working files (finals are committed in public/)
/scripts/out/
