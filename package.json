{
  "name": "merigaud.com",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio of Dylan Mérigaud, freelance AI full-stack engineer for fintech. Next.js, React Three Fiber, TypeScript strict.",
  "author": "Dylan Mérigaud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DylanMerigaud/merigaud.com.git"
  },
  "homepage": "https://merigaud.com",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "prettier": "@dylanmerigaud/config/prettier",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "tsx --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"components/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && pnpm run test",
    "hero:generate": "tsx scripts/generate-hero.ts",
    "og:generate": "tsx scripts/generate-og.ts"
  },
  "dependencies": {
    "@dylanmerigaud/microsaas-kit": "^0.13.1",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "posthog-js": "^1.447.3",
    "posthog-node": "^5.63.1",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dylanmerigaud/config": "^0.4.0",
    "@fal-ai/client": "^1.10.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^10.14",
    "knip": "^6.44.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
